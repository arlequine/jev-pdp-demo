# API nativa de Jev (TypeSafe). No va a git: copia este archivo a .env
# Crea la key en https://console.typesafe.ai/keys (mismo nombre que usan los SDKs y la agent skill).
TYPESAFE_API_KEY=
# Endpoint: POST {TYPESAFE_BASE_URL}/v1/systemone (docs.typesafe.ai/api/system-one)
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Versión fijada: los umbrales están calibrados contra ella. No uses jev-latest.
JEV_MODEL=jev-1.13
# live = llama a Jev · record = llama y guarda en recordings/ · replay = solo grabaciones (sin red)
JEV_MODE=replay
