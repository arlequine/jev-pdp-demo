# API nativa de Jev (TypeSafe). No va a git: copia este archivo a .env
# Crea la key en https://console.typesafe.ai/keys (mismo nombre que usan los SDKs y la agent skill).
TYPESAFE_API_KEY=
# Endpoint: POST {TYPESAFE_BASE_URL}/v1/systemone (docs.typesafe.ai/api/system-one)
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Modelo: jev-latest sigue a la versión más nueva. Para fijar una, usa un nombre exacto de `npm run jev:models`.
JEV_MODEL=jev-latest
# auto = usa la grabación si existe y si no pregunta a Jev en vivo y la guarda (recomendado para la demo)
# live = siempre en vivo · record = en vivo y graba · replay = solo grabaciones (sin red)
JEV_MODE=auto
