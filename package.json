{
  "name": "jev-pdp-demo",
  "private": true,
  "version": "1.0.0",
  "description": "Demo de la charla «Pregúntale a la IA lo justo»: Jev decide, Claude genera, el código pone las reglas.",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/jev-flow",
    "packages/jev-mcp"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc -p apps/api && tsc -p apps/web && tsc -p packages/jev-flow && tsc -p packages/jev-mcp",
    "test": "vitest run",
    "fire": "tsx scripts/fire.ts",
    "prioritize": "tsx packages/jev-flow/src/prioritize/cli.ts",
    "compare": "tsx packages/jev-flow/src/compare/cli.ts",
    "review": "tsx packages/jev-flow/src/review/cli.ts",
    "rules:compare": "tsx packages/jev-flow/src/rules-compare/cli.ts",
    "cost": "tsx packages/jev-flow/src/cost/cli.ts",
    "recordings:simulate": "tsx scripts/simulate-recordings.ts",
    "demo:reset": "bash scripts/demo-reset.sh",
    "mcp": "tsx packages/jev-mcp/src/server.ts",
    "mcp:check": "tsx packages/jev-mcp/src/check.ts",
    "jev:models": "tsx scripts/jev-models.ts",
    "dashboard": "tsx scripts/dashboard.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
